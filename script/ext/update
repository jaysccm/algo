#!/usr/bin/env python3
"""Deploy one verified Pinchy image while preserving HALT and timer state.

This is the project's update hook: script/update (the standard) runs pre-update, then this, then post-update. It owns
the whole guarded update including the checkout: it verifies the full commit and the loaded image ID, requires running
stacks and the live HALT sentinel, pauses the timers that were active, backs up and validates both databases, switches
the checkout and release image, migrates, waits for health, and on failure restores the previous commit and image with
timers stopped if it cannot. The ref comes from REF (set by script/update) or the positional argument.
"""

from __future__ import annotations

import argparse
import fcntl
import os
import re
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
TASK = "/home/jay/.local/bin/task"
INSTANCES = ("live", "paper")
TIMERS = (
    "pinchy-paper-session.timer",
    "pinchy-live-backup.timer",
    "pinchy-paper-backup.timer",
    "pinchy-live-session.timer",
    "pinchy-weekly-learn.timer",
)
JOBS = tuple(name.removesuffix(".timer") + ".service" for name in TIMERS)
LIVE_TIMERS = ("pinchy-live-session.timer", "pinchy-weekly-learn.timer")
IMAGE_FILE = ROOT / ".release-image"


class DeployError(Exception):
    pass


def call(*args: str, env: dict[str, str] | None = None, stdin: Path | None = None, check: bool = True) -> tuple[int, str]:
    try:
        with stdin.open("rb") if stdin else open(os.devnull, "rb") as source:
            result = subprocess.run(
                args, cwd=ROOT, env=env, stdin=source, capture_output=True, text=True, check=False
            )
    except OSError as exc:
        raise DeployError(f"{args[0]} unavailable: {exc.strerror}") from exc
    if check and result.returncode != 0:
        # Tool stderr may contain credential-bearing environment details.
        raise DeployError(f"{args[0]} {args[1] if len(args) > 1 else ''} failed (exit {result.returncode})")
    return result.returncode, result.stdout.strip()


def release_env(image: str) -> dict[str, str]:
    return {
        **os.environ,
        "DEPLOY_IMAGE": image,
        "COMPOSE_FILE": f"{ROOT / 'docker-compose.yml'}:{ROOT / 'compose.release.yml'}",
    }


def compose(instance: str, image: str, *args: str, stdin: Path | None = None) -> str:
    _, output = call(
        "docker", "compose", "-p", f"pinchy-{instance}", "--env-file", f"instances/{instance}.env",
        *args, env=release_env(image), stdin=stdin,
    )
    return output


def active(unit: str) -> bool:
    rc, state = call("systemctl", "is-active", unit, check=False)
    if state not in {"active", "inactive", "failed"}:
        raise DeployError(f"Cannot determine state of {unit}: {state or rc}")
    return state == "active"


def enabled(unit: str) -> bool:
    _, state = call("systemctl", "is-enabled", unit, check=False)
    if state not in {"enabled", "disabled"}:
        raise DeployError(f"Cannot determine enablement of {unit}: {state or 'unknown'}")
    return state == "enabled"


def halt_markers() -> set[str]:
    markers = {"HALT"} if (ROOT / "HALT").exists() else set()
    markers.update(str(path.relative_to(ROOT)) for path in (ROOT / "instances").glob("*.HALT"))
    return markers


def write_image(image: str) -> None:
    temporary = ROOT / ".release-image.partial"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as stream:
        stream.write(image + "\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, IMAGE_FILE)


def check_instance_files() -> None:
    for name in INSTANCES:
        path = ROOT / "instances" / f"{name}.env"
        if not path.is_file():
            raise DeployError(f"Missing {path}")
        if stat.S_IMODE(path.stat().st_mode) & 0o077:
            raise DeployError(f"{path} must not be accessible by group or other users")
    host_env = ROOT / ".env.host"
    if not host_env.is_file() or stat.S_IMODE(host_env.stat().st_mode) & 0o077:
        raise DeployError(f"{host_env} is missing or too broadly readable")


def check_stack_running(image: str) -> None:
    expected = {"db", "trading", "dashboard"}
    for name in INSTANCES:
        running = set(compose(name, image, "ps", "--status", "running", "--services").splitlines())
        if running != expected:
            raise DeployError(f"{name} stack is not fully running; stopped services must stay stopped")


def verify_target(ref: str, expected_id: str) -> str:
    if not re.fullmatch(r"[0-9a-f]{40}", ref):
        raise DeployError("Target must be a full 40-character commit SHA")
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", expected_id):
        raise DeployError("Expected image ID must be a full sha256 digest")
    if call("git", "status", "--porcelain", "--untracked-files=no")[1]:
        raise DeployError("Tracked checkout changes must be resolved before deployment")
    call("git", "fetch", "origin", ref)
    if call("git", "rev-parse", "FETCH_HEAD")[1] != ref:
        raise DeployError("Fetched commit does not match requested SHA")
    if call("git", "ls-tree", "--name-only", ref, "--", "instances/live.HALT")[1] != "instances/live.HALT":
        raise DeployError("Target commit lacks instances/live.HALT")
    image = f"algo:{ref}"
    actual_id = call("docker", "image", "inspect", "--format", "{{.Id}}", image)[1]
    if actual_id != expected_id:
        raise DeployError("Verified release image ID does not match the loaded image")
    return image


def backup(instance: str, image: str) -> None:
    before = set((ROOT / "backups").glob(f"{instance}-*.dump"))
    call(TASK, "db:backup", f"INSTANCE={instance}", env=release_env(image))
    created = set((ROOT / "backups").glob(f"{instance}-*.dump")) - before
    if len(created) != 1:
        raise DeployError(f"{instance} backup did not create exactly one new archive")
    archive = created.pop()
    if archive.stat().st_size == 0:
        raise DeployError(f"{instance} backup is empty")
    compose(instance, image, "exec", "-T", "db", "pg_restore", "-l", stdin=archive)
    print(f"validated {instance} backup: {archive.name}")


def migrate_and_start(image: str) -> None:
    for name in INSTANCES:
        call(TASK, "db:migrate", f"INSTANCE={name}", env=release_env(image))
    for name in INSTANCES:
        compose(name, image, "up", "-d", "--no-build", "--pull", "never", "db", "trading", "dashboard")


def healthy(image: str) -> None:
    image_id = call("docker", "image", "inspect", "--format", "{{.Id}}", image)[1]
    for name in INSTANCES:
        deadline = time.monotonic() + 120
        while True:
            try:
                compose(name, image, "exec", "-T", "db", "pg_isready", "-U", "algo", "-d", "trading")
                compose(name, image, "exec", "-T", "trading", "true")
                compose(
                    name, image, "exec", "-T", "dashboard", "python", "-c",
                    "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3000/health', timeout=3)",
                )
                for service in ("trading", "dashboard"):
                    container = compose(name, image, "ps", "-q", service)
                    if not container or call("docker", "inspect", "--format", "{{.Image}}", container)[1] != image_id:
                        raise DeployError(f"{name} {service} is not running the verified image")
                break
            except DeployError:
                if time.monotonic() >= deadline:
                    raise DeployError(f"{name} database, trading or dashboard failed health checks") from None
                time.sleep(3)


def restore_timers(previously_active: list[str]) -> None:
    for timer in previously_active:
        call("sudo", "-n", "systemctl", "start", timer)


def deploy(ref: str, expected_id: str) -> None:
    check_instance_files()
    markers = halt_markers()
    if "instances/live.HALT" not in markers:
        raise DeployError("Live HALT sentinel is missing")
    old_ref = call("git", "rev-parse", "HEAD")[1]
    old_image = IMAGE_FILE.read_text().strip() if IMAGE_FILE.exists() else ""
    if not re.fullmatch(r"algo:[0-9a-f]{40}", old_image):
        raise DeployError("No prior release image; initial installation needs a separate rehearsal")
    image = verify_target(ref, expected_id)
    check_stack_running(old_image)
    for timer in TIMERS:
        enabled(timer)
    if any(enabled(timer) or active(timer) for timer in LIVE_TIMERS):
        raise DeployError("Live trading timers must remain disabled")
    if any(active(job) for job in JOBS):
        raise DeployError("A Pinchy job is running; retry after it finishes")
    if old_ref == ref and old_image == image:
        healthy(image)
        print("already deployed and healthy")
        return

    previously_active = [timer for timer in TIMERS if active(timer)]
    paused: list[str] = []
    switched = False
    try:
        for timer in previously_active:
            call("sudo", "-n", "systemctl", "stop", timer)
            paused.append(timer)
        if any(active(job) for job in JOBS):
            raise DeployError("A Pinchy job started while timers were being paused")
        for name in INSTANCES:
            backup(name, old_image)
        call("git", "checkout", "--detach", ref)
        switched = True
        if halt_markers() != markers:
            raise DeployError("HALT markers changed at the target commit")
        write_image(image)
        migrate_and_start(image)
        healthy(image)
        restore_timers(paused)
    except (Exception, KeyboardInterrupt) as exc:
        print(f"deployment failed: {exc}", file=sys.stderr)
        try:
            for timer in paused:
                call("sudo", "-n", "systemctl", "stop", timer)
        except DeployError as pause_exc:
            raise DeployError(f"Cannot pause timers for rollback: {pause_exc}") from exc
        if switched:
            try:
                call("git", "checkout", "--detach", old_ref)
                write_image(old_image)
                migrate_and_start(old_image)
                healthy(old_image)
            except Exception as rollback_exc:
                raise DeployError(f"Rollback failed; timers remain stopped: {rollback_exc}") from exc
        restore_timers(paused)
        raise DeployError("Previous release restored; database migrations were not reversed") from exc
    print(f"deployed {ref} ({expected_id})")
    status_rc, status_text = call("python3", "scripts/status.py", check=False)
    if status_rc == 0:
        print(status_text)
    else:
        print("warning: status command could not report the deployment", file=sys.stderr)


def main() -> int:
    def terminate(_signum, _frame):
        raise DeployError("Update interrupted")

    signal.signal(signal.SIGTERM, terminate)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("ref", nargs="?", default=os.environ.get("REF", ""), help="Full commit SHA to deploy (default: $REF)")
    parser.add_argument("--expected-image-id", default=os.environ.get("EXPECTED_IMAGE_ID", ""))
    args = parser.parse_args()
    try:
        with (ROOT / ".update.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            deploy(args.ref, args.expected_image_id)
    except BlockingIOError:
        print("Another Pinchy update is running", file=sys.stderr)
        return 3
    except DeployError as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
